{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khelix1/PrinterHMI-Remote/protocol/relay-enrollment-v1.schema.json",
  "title": "PrinterHMI Remote relay enrollment v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "challenge_id", "relay_id", "nonce", "audience", "issued_at", "expires_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "type": { "const": "relay.challenge" },
        "challenge_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "relay_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "audience": { "type": "string", "pattern": "^phm_[a-z2-7]{26}$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "challenge", "pairing_id", "code", "peer_id", "peer_public_key", "peer_signature"],
      "properties": {
        "schema_version": { "const": 1 },
        "type": { "const": "relay.enrollment-request" },
        "challenge": { "$ref": "#/$defs/challenge" },
        "pairing_id": { "type": "string", "format": "uuid" },
        "code": { "type": "string", "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}-?[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}$" },
        "peer_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "peer_public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "peer_signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "type", "challenge_id", "relay_id", "pairing_id", "device_id", "device_public_key", "peer_id", "peer_public_key", "enrolled_at", "signature"],
      "properties": {
        "schema_version": { "const": 1 },
        "type": { "const": "agent.enrollment-receipt" },
        "challenge_id": { "type": "string", "format": "uuid" },
        "relay_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "pairing_id": { "type": "string", "format": "uuid" },
        "device_id": { "type": "string", "pattern": "^phm_[a-z2-7]{26}$" },
        "device_public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "peer_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "peer_public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "enrolled_at": { "type": "string", "format": "date-time" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
